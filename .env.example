# Copy to .env and set a fresh token issued by @BotFather.
BOT_TOKEN=replace_with_a_new_bot_token
# Comma-separated numeric Telegram user IDs allowed to administer the bot.
# Leave blank only for first-run bootstrap; send /myid, set the result here, then restart.
ADMIN_IDS=
DATABASE_PATH=data/telegram_migration.sqlite3
DEFAULT_ACTION_QUOTA=50
QUOTA_WINDOW_HOURS=24
LOG_LEVEL=INFO
MIGRATION_ANNOUNCEMENT=Community migration: {campaign_name}. Members are invited to request access voluntarily.
